{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/*.js": {"maxDuration": 20}},
  "rewrites": [{"source": "/admin", "destination": "/admin.html"}],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"}
    ]},
    {"source": "/admin", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/admin.html", "headers": [
      {"key": "Cache-Control", "value": "no-store"},
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
    ]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "private, no-store, max-age=0"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
