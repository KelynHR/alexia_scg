# En Vercel: URL PostgreSQL de Neon, solo en el servidor.
# En tu computadora: déjala vacía para usar data/reservas.sqlite.
DATABASE_URL=
# Cambia esta dirección por el dominio HTTPS final al publicar.
APP_ORIGIN=http://localhost:3000
# Genera estos valores con npm run setup-local o configura tus propios secretos.
# Contraseña de al menos 16 caracteres; secreto aleatorio de al menos 32.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
